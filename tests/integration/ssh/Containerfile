FROM alpine@sha256:bfe7ceb9f09ec0566c48fb93356e45a47a00be5a1dd14fa5b909e7709c66b034
RUN apk add --no-cache openssh && adduser -D tester && echo 'tester:termiashell-test-only' | chpasswd && ssh-keygen -A && mkdir -p /run/sshd
RUN printf 'HostKey /etc/ssh/ssh_host_ed25519_key\nPasswordAuthentication yes\nPermitRootLogin no\nAllowUsers tester\nSubsystem sftp internal-sftp\nAllowTcpForwarding no\nX11Forwarding no\n' > /etc/ssh/sshd_config
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
